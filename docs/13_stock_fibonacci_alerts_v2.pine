    alertMsg := alertMsg + " + D:200 (+" + str.tostring(distD200AMD, "#.#") + "%)\n"
    alertMsg := alertMsg + "Volume: " + volAMD + "\n\nNote: Quantities based on initial allocation for guidance only"
