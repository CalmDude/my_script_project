//@version=5
indicator("Stock Fibonacci Alerts v2 - Dashboard Aligned", overlay=false)

// ========== INPUTS ==========
// Larsson Line Settings
larssonV1 = input.int(15, title="Larsson V1 (Fast)", minval=1, group="Larsson Line")
larssonM1 = input.int(19, title="Larsson M1", minval=1, group="Larsson Line")
larssonM2 = input.int(25, title="Larsson M2", minval=1, group="Larsson Line")
larssonV2 = input.int(29, title="Larsson V2 (Slow)", minval=1, group="Larsson Line")

// Fibonacci Settings
lookbackPeriod = input.int(100, title="Lookback Period for Swing High/Low", minval=10, group="Fibonacci")
proximityThreshold = input.float(2.0, title="Fibonacci Proximity % (for alerts)", minval=0.5, maxval=5.0, group="Fibonacci")

// Position Sizing
alloc382 = input.int(20, title="38.2% Allocation %", minval=1, maxval=100, group="Position Sizing")
alloc500 = input.int(30, title="50.0% Allocation %", minval=1, maxval=100, group="Position Sizing")
alloc618 = input.int(50, title="61.8% Allocation %", minval=1, maxval=100, group="Position Sizing")

// Volume Settings
volumeShortPeriod = input.int(3, title="Volume Short Period", minval=1, group="Volume")
volumeLongPeriod = input.int(20, title="Volume Long Period", minval=1, group="Volume")

// Alert Settings
enableBuyAlerts = input.bool(true, title="Enable BUY Entry Alerts", group="Alerts")
enableExitAlerts = input.bool(true, title="Enable EXIT Alerts", group="Alerts")

// ========== STOCK INPUTS ==========
dollarALAB = input.float(0.0, title="ALAB $ Amount", minval=0.0, group="Stock: ALAB")
dollarAMD = input.float(0.0, title="AMD $ Amount", minval=0.0, group="Stock: AMD")
dollarARM = input.float(0.0, title="ARM $ Amount", minval=0.0, group="Stock: ARM")
dollarASML = input.float(0.0, title="ASML $ Amount", minval=0.0, group="Stock: ASML")
dollarAVGO = input.float(0.0, title="AVGO $ Amount", minval=0.0, group="Stock: AVGO")
dollarGOOG = input.float(0.0, title="GOOG $ Amount", minval=0.0, group="Stock: GOOG")
dollarMRVL = input.float(0.0, title="MRVL $ Amount", minval=0.0, group="Stock: MRVL")
dollarMSTR = input.float(0.0, title="MSTR $ Amount", minval=0.0, group="Stock: MSTR")
dollarMU = input.float(0.0, title="MU $ Amount", minval=0.0, group="Stock: MU")
dollarNVDA = input.float(0.0, title="NVDA $ Amount", minval=0.0, group="Stock: NVDA")
dollarPLTR = input.float(0.0, title="PLTR $ Amount", minval=0.0, group="Stock: PLTR")
dollarTSLA = input.float(0.0, title="TSLA $ Amount", minval=0.0, group="Stock: TSLA")
dollarTSM = input.float(0.0, title="TSM $ Amount", minval=0.0, group="Stock: TSM")

// ========== HELPER FUNCTIONS ==========

// Get all signals and fib levels for a stock (consolidated to minimize security calls)
getAllData(ticker, dollarAmount) =>
    // Consolidated daily data - one security call
    [dailyClose, sma200D, volShort, volLong, swingHigh, swingLow] = request.security(ticker, "D", 
     [close, ta.sma(close, 200), ta.sma(volume, volumeShortPeriod), ta.sma(volume, volumeLongPeriod), 
      ta.highest(high, lookbackPeriod), ta.lowest(low, lookbackPeriod)], lookahead=barmerge.lookahead_off)
    
    // Consolidated weekly data - one security call
    [wV1, wM1, wM2, wV2, sma200W] = request.security(ticker, "W", 
     [ta.rma(close, larssonV1), ta.rma(close, larssonM1), ta.rma(close, larssonM2), ta.rma(close, larssonV2), ta.sma(close, 200)], 
     lookahead=barmerge.lookahead_off)
    
    // Weekly status
    isWeeklyGold = wV1 > wV2 and wV1 > wM1 and wM1 > wM2 and wM2 > wV2
    isWeeklyBlue = wV1 < wV2 and wV1 < wM1 and wM1 < wM2 and wM2 < wV2
    weeklyStatus = isWeeklyGold ? "GOLD" : isWeeklyBlue ? "BLUE" : "GRAY"
    
    // 200 SMA checks
    aboveDaily200 = dailyClose > sma200D
    aboveWeekly200 = na(sma200W) or dailyClose > sma200W
    distD200 = ((dailyClose - sma200D) / sma200D) * 100
    distW200 = na(sma200W) ? 0.0 : ((dailyClose - sma200W) / sma200W) * 100
    
    // Volume status
    volStatus = volShort < volLong ? "Declining" : volShort > volLong ? "Rising" : "Neutral"
    
    // Signal logic
    buySignal = weeklyStatus == "GOLD" and aboveWeekly200 and aboveDaily200
    exit50Signal = weeklyStatus == "GRAY" and aboveDaily200 and aboveWeekly200
    exit100Signal = weeklyStatus == "BLUE" or not aboveWeekly200 or not aboveDaily200
    exitReason = weeklyStatus == "BLUE" ? "Weekly BLUE" : 
                 not aboveWeekly200 and not aboveDaily200 ? "Both 200 SMAs broken" :
                 not aboveWeekly200 ? "Weekly 200 SMA broken" : "Daily 200 SMA broken"
    
    // Fibonacci levels
    priceRange = swingHigh - swingLow
    fib382 = swingHigh - (priceRange * 0.382)
    fib500 = swingHigh - (priceRange * 0.500)
    fib618 = swingHigh - (priceRange * 0.618)
    
    // Proximity detection
    threshold = proximityThreshold / 100
    atFib382 = math.abs(dailyClose - fib382) / fib382 <= threshold
    atFib500 = math.abs(dailyClose - fib500) / fib500 <= threshold
    atFib618 = math.abs(dailyClose - fib618) / fib618 <= threshold
    
    // Calculate share quantities
    qty382 = dollarAmount > 0 and dailyClose > 0 ? math.floor((dollarAmount * alloc382 / 100) / dailyClose) : 0
    qty500 = dollarAmount > 0 and dailyClose > 0 ? math.floor((dollarAmount * alloc500 / 100) / dailyClose) : 0
    qty618 = dollarAmount > 0 and dailyClose > 0 ? math.floor((dollarAmount * alloc618 / 100) / dailyClose) : 0
    
    [dailyClose, buySignal, exit50Signal, exit100Signal, weeklyStatus, distD200, distW200, volStatus, exitReason,
     atFib382, atFib500, atFib618, fib382, fib500, fib618, qty382, qty500, qty618]

// ========== GET SIGNALS FOR ALL STOCKS ==========
[priceALAB, buyALAB, exit50ALAB, exit100ALAB, weeklyALAB, distD200ALAB, distW200ALAB, volALAB, exitReasonALAB, atFib382ALAB, atFib500ALAB, atFib618ALAB, fib382ALAB, fib500ALAB, fib618ALAB, qty382ALAB, qty500ALAB, qty618ALAB] = getAllData("NASDAQ:ALAB", dollarALAB)

[priceAMD, buyAMD, exit50AMD, exit100AMD, weeklyAMD, distD200AMD, distW200AMD, volAMD, exitReasonAMD, atFib382AMD, atFib500AMD, atFib618AMD, fib382AMD, fib500AMD, fib618AMD, qty382AMD, qty500AMD, qty618AMD] = getAllData("NASDAQ:AMD", dollarAMD)

[priceARM, buyARM, exit50ARM, exit100ARM, weeklyARM, distD200ARM, distW200ARM, volARM, exitReasonARM, atFib382ARM, atFib500ARM, atFib618ARM, fib382ARM, fib500ARM, fib618ARM, qty382ARM, qty500ARM, qty618ARM] = getAllData("NASDAQ:ARM", dollarARM)

[priceASML, buyASML, exit50ASML, exit100ASML, weeklyASML, distD200ASML, distW200ASML, volASML, exitReasonASML, atFib382ASML, atFib500ASML, atFib618ASML, fib382ASML, fib500ASML, fib618ASML, qty382ASML, qty500ASML, qty618ASML] = getAllData("NASDAQ:ASML", dollarASML)

[priceAVGO, buyAVGO, exit50AVGO, exit100AVGO, weeklyAVGO, distD200AVGO, distW200AVGO, volAVGO, exitReasonAVGO, atFib382AVGO, atFib500AVGO, atFib618AVGO, fib382AVGO, fib500AVGO, fib618AVGO, qty382AVGO, qty500AVGO, qty618AVGO] = getAllData("NASDAQ:AVGO", dollarAVGO)

[priceGOOG, buyGOOG, exit50GOOG, exit100GOOG, weeklyGOOG, distD200GOOG, distW200GOOG, volGOOG, exitReasonGOOG, atFib382GOOG, atFib500GOOG, atFib618GOOG, fib382GOOG, fib500GOOG, fib618GOOG, qty382GOOG, qty500GOOG, qty618GOOG] = getAllData("NASDAQ:GOOG", dollarGOOG)

[priceMRVL, buyMRVL, exit50MRVL, exit100MRVL, weeklyMRVL, distD200MRVL, distW200MRVL, volMRVL, exitReasonMRVL, atFib382MRVL, atFib500MRVL, atFib618MRVL, fib382MRVL, fib500MRVL, fib618MRVL, qty382MRVL, qty500MRVL, qty618MRVL] = getAllData("NASDAQ:MRVL", dollarMRVL)

[priceMSTR, buyMSTR, exit50MSTR, exit100MSTR, weeklyMSTR, distD200MSTR, distW200MSTR, volMSTR, exitReasonMSTR, atFib382MSTR, atFib500MSTR, atFib618MSTR, fib382MSTR, fib500MSTR, fib618MSTR, qty382MSTR, qty500MSTR, qty618MSTR] = getAllData("NASDAQ:MSTR", dollarMSTR)

[priceMU, buyMU, exit50MU, exit100MU, weeklyMU, distD200MU, distW200MU, volMU, exitReasonMU, atFib382MU, atFib500MU, atFib618MU, fib382MU, fib500MU, fib618MU, qty382MU, qty500MU, qty618MU] = getAllData("NASDAQ:MU", dollarMU)

[priceNVDA, buyNVDA, exit50NVDA, exit100NVDA, weeklyNVDA, distD200NVDA, distW200NVDA, volNVDA, exitReasonNVDA, atFib382NVDA, atFib500NVDA, atFib618NVDA, fib382NVDA, fib500NVDA, fib618NVDA, qty382NVDA, qty500NVDA, qty618NVDA] = getAllData("NASDAQ:NVDA", dollarNVDA)

[pricePLTR, buyPLTR, exit50PLTR, exit100PLTR, weeklyPLTR, distD200PLTR, distW200PLTR, volPLTR, exitReasonPLTR, atFib382PLTR, atFib500PLTR, atFib618PLTR, fib382PLTR, fib500PLTR, fib618PLTR, qty382PLTR, qty500PLTR, qty618PLTR] = getAllData("NASDAQ:PLTR", dollarPLTR)

[priceTSLA, buyTSLA, exit50TSLA, exit100TSLA, weeklyTSLA, distD200TSLA, distW200TSLA, volTSLA, exitReasonTSLA, atFib382TSLA, atFib500TSLA, atFib618TSLA, fib382TSLA, fib500TSLA, fib618TSLA, qty382TSLA, qty500TSLA, qty618TSLA] = getAllData("NASDAQ:TSLA", dollarTSLA)

[priceTSM, buyTSM, exit50TSM, exit100TSM, weeklyTSM, distD200TSM, distW200TSM, volTSM, exitReasonTSM, atFib382TSM, atFib500TSM, atFib618TSM, fib382TSM, fib500TSM, fib618TSM, qty382TSM, qty500TSM, qty618TSM] = getAllData("NYSE:TSM", dollarTSM)

// ========== STATE TRACKING ==========
var bool prevBuyALAB382 = false, var bool prevBuyALAB500 = false, var bool prevBuyALAB618 = false
var bool prevExit50ALAB = false, var bool prevExit100ALAB = false

var bool prevBuyAMD382 = false, var bool prevBuyAMD500 = false, var bool prevBuyAMD618 = false
var bool prevExit50AMD = false, var bool prevExit100AMD = false

var bool prevBuyARM382 = false, var bool prevBuyARM500 = false, var bool prevBuyARM618 = false
var bool prevExit50ARM = false, var bool prevExit100ARM = false

