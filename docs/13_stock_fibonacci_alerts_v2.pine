    alertMsg := alertMsg + " (" + str.tostring(alloc618) + "% = $" + str.tostring(dollarARM * alloc618 / 100, "#") + ")\n"
    alertMsg := alertMsg + "Weekly GOLD + W:200 (+" + str.tostring(distW200ARM, "#.#") + "%)"
    alertMsg := alertMsg + " + D:200 (+" + str.tostring(distD200ARM, "#.#") + "%)\n"
    alertMsg := alertMsg + "Volume: " + volARM + "\n\nNote: Quantities based on initial allocation for guidance only"
    alert(alertMsg, alert.freq_once_per_bar)
prevBuyARM618 := buyARM and atFib618ARM

