    alert("EXIT 100% - ARM\nPrice: $" + str.tostring(priceARM, "#.##") + "\n✗ " + exitReasonARM, alert.freq_once_per_bar)
prevExit100ARM := exit100ARM

// ========== ALERTS - ASML ==========
if enableBuyAlerts and buyASML and atFib382ASML and not prevBuyASML382
    alertMsg = "BUY SIGNAL - ASML at 38.2% Fib ($" + str.tostring(fib382ASML, "#.##") + ")\n"
    alertMsg := alertMsg + "Price: $" + str.tostring(priceASML, "#.##") + " | Qty: " + str.tostring(qty382ASML)
    alertMsg := alertMsg + " (" + str.tostring(alloc382) + "% = $" + str.tostring(dollarASML * alloc382 / 100, "#") + ")\n"
    alertMsg := alertMsg + "Weekly GOLD + W:200 (+" + str.tostring(distW200ASML, "#.#") + "%)"
    alertMsg := alertMsg + " + D:200 (+" + str.tostring(distD200ASML, "#.#") + "%)\n"
    alertMsg := alertMsg + "Volume: " + volASML + "\n\nNote: Quantities based on initial allocation for guidance only"
    alert(alertMsg, alert.freq_once_per_bar)
prevBuyASML382 := buyASML and atFib382ASML

if enableBuyAlerts and buyASML and atFib500ASML and not prevBuyASML500
    alertMsg = "BUY SIGNAL - ASML at 50.0% Fib ($" + str.tostring(fib500ASML, "#.##") + ")\n"
    alertMsg := alertMsg + "Price: $" + str.tostring(priceASML, "#.##") + " | Qty: " + str.tostring(qty500ASML)
