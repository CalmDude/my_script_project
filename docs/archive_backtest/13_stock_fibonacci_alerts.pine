swingHighNVDA = useAutoSwing ? autoHighNVDA : (manualHighNVDA > 0.0 ? manualHighNVDA : autoHighNVDA)
swingLowNVDA = useAutoSwing ? autoLowNVDA : (manualLowNVDA > 0.0 ? manualLowNVDA : autoLowNVDA)

// ========== STOCK 11: PLTR ==========
symPLTR = input.string("NASDAQ:PLTR", title="PLTR Symbol")
autoHighPLTR = request.security("NASDAQ:PLTR", "D", ta.highest(high, lookbackPeriod))
autoLowPLTR = request.security("NASDAQ:PLTR", "D", ta.lowest(low, lookbackPeriod))
manualHighPLTR = input.float(0.0, title="PLTR Swing High (Override when Auto-Calc OFF)", minval=0.0)
manualLowPLTR = input.float(0.0, title="PLTR Swing Low (Override when Auto-Calc OFF)", minval=0.0)
dollarPLTR = input.float(0.0, title="PLTR $ Amount", minval=0.0)
swingHighPLTR = useAutoSwing ? autoHighPLTR : (manualHighPLTR > 0.0 ? manualHighPLTR : autoHighPLTR)
swingLowPLTR = useAutoSwing ? autoLowPLTR : (manualLowPLTR > 0.0 ? manualLowPLTR : autoLowPLTR)

// ========== STOCK 12: TSLA ==========
symTSLA = input.string("NASDAQ:TSLA", title="TSLA Symbol")
autoHighTSLA = request.security("NASDAQ:TSLA", "D", ta.highest(high, lookbackPeriod))
autoLowTSLA = request.security("NASDAQ:TSLA", "D", ta.lowest(low, lookbackPeriod))
manualHighTSLA = input.float(0.0, title="TSLA Swing High (Override when Auto-Calc OFF)", minval=0.0)
manualLowTSLA = input.float(0.0, title="TSLA Swing Low (Override when Auto-Calc OFF)", minval=0.0)
