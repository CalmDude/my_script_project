autoHighMSTR = request.security("NASDAQ:MSTR", "D", ta.highest(high, lookbackPeriod))
autoLowMSTR = request.security("NASDAQ:MSTR", "D", ta.lowest(low, lookbackPeriod))
manualHighMSTR = input.float(0.0, title="MSTR Swing High (Override when Auto-Calc OFF)", minval=0.0)
manualLowMSTR = input.float(0.0, title="MSTR Swing Low (Override when Auto-Calc OFF)", minval=0.0)
dollarMSTR = input.float(0.0, title="MSTR $ Amount", minval=0.0)
swingHighMSTR = useAutoSwing ? autoHighMSTR : (manualHighMSTR > 0.0 ? manualHighMSTR : autoHighMSTR)
swingLowMSTR = useAutoSwing ? autoLowMSTR : (manualLowMSTR > 0.0 ? manualLowMSTR : autoLowMSTR)

// ========== STOCK 9: MU ==========
symMU = input.string("NASDAQ:MU", title="MU Symbol")
autoHighMU = request.security("NASDAQ:MU", "D", ta.highest(high, lookbackPeriod))
autoLowMU = request.security("NASDAQ:MU", "D", ta.lowest(low, lookbackPeriod))
manualHighMU = input.float(0.0, title="MU Swing High (Override when Auto-Calc OFF)", minval=0.0)
manualLowMU = input.float(0.0, title="MU Swing Low (Override when Auto-Calc OFF)", minval=0.0)
dollarMU = input.float(0.0, title="MU $ Amount", minval=0.0)
swingHighMU = useAutoSwing ? autoHighMU : (manualHighMU > 0.0 ? manualHighMU : autoHighMU)
swingLowMU = useAutoSwing ? autoLowMU : (manualLowMU > 0.0 ? manualLowMU : autoLowMU)

// ========== STOCK 10: NVDA ==========
symNVDA = input.string("NASDAQ:NVDA", title="NVDA Symbol")
autoHighNVDA = request.security("NASDAQ:NVDA", "D", ta.highest(high, lookbackPeriod))
autoLowNVDA = request.security("NASDAQ:NVDA", "D", ta.lowest(low, lookbackPeriod))
manualHighNVDA = input.float(0.0, title="NVDA Swing High (Override when Auto-Calc OFF)", minval=0.0)
manualLowNVDA = input.float(0.0, title="NVDA Swing Low (Override when Auto-Calc OFF)", minval=0.0)
