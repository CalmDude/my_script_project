//@version=5
indicator("Stock Fibonacci Alerts", overlay=false, dynamic_requests=true)

// ========== LOOKBACK SETTINGS ==========
lookbackPeriod = input.int(100, title="Days to Lookback for Auto Swing Calculation", minval=1)
useAutoSwing = input.bool(true, title="Auto-Calculate Swing High/Low from Lookback")
recoveryConfirmationBuffer = input.float(1.5, title="Recovery Confirmation Buffer %", minval=0.5, maxval=5.0, tooltip="Price must be this % above Fib level for recovery entry")

// ========== STOCK 1: ALAB ==========
symALAB = input.string("NASDAQ:ALAB", title="ALAB Symbol")
autoHighALAB = request.security("NASDAQ:ALAB", "D", ta.highest(high, lookbackPeriod))
autoLowALAB = request.security("NASDAQ:ALAB", "D", ta.lowest(low, lookbackPeriod))
manualHighALAB = input.float(0.0, title="ALAB Swing High (Override when Auto-Calc OFF)", minval=0.0)
manualLowALAB = input.float(0.0, title="ALAB Swing Low (Override when Auto-Calc OFF)", minval=0.0)
dollarALAB = input.float(0.0, title="ALAB $ Amount", minval=0.0)
swingHighALAB = useAutoSwing ? autoHighALAB : (manualHighALAB > 0.0 ? manualHighALAB : autoHighALAB)
swingLowALAB = useAutoSwing ? autoLowALAB : (manualLowALAB > 0.0 ? manualLowALAB : autoLowALAB)

// ========== STOCK 2: AMD ==========
symAMD = input.string("NASDAQ:AMD", title="AMD Symbol")
autoHighAMD = request.security("NASDAQ:AMD", "D", ta.highest(high, lookbackPeriod))
autoLowAMD = request.security("NASDAQ:AMD", "D", ta.lowest(low, lookbackPeriod))
manualHighAMD = input.float(0.0, title="AMD Swing High (Override when Auto-Calc OFF)", minval=0.0)
manualLowAMD = input.float(0.0, title="AMD Swing Low (Override when Auto-Calc OFF)", minval=0.0)
dollarAMD = input.float(0.0, title="AMD $ Amount", minval=0.0)
swingHighAMD = useAutoSwing ? autoHighAMD : (manualHighAMD > 0.0 ? manualHighAMD : autoHighAMD)
swingLowAMD = useAutoSwing ? autoLowAMD : (manualLowAMD > 0.0 ? manualLowAMD : autoLowAMD)

// ========== STOCK 3: ARM ==========
symARM = input.string("NASDAQ:ARM", title="ARM Symbol")
autoHighARM = request.security("NASDAQ:ARM", "D", ta.highest(high, lookbackPeriod))
autoLowARM = request.security("NASDAQ:ARM", "D", ta.lowest(low, lookbackPeriod))
