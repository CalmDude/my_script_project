autoHighMSTR = request.security("NASDAQ:MSTR", "D", ta.highest(high, lookbackPeriod))
autoLowMSTR = request.security("NASDAQ:MSTR", "D", ta.lowest(low, lookbackPeriod))
manualHighMSTR = input.float(0.0, title="MSTR Swing High (Override when Auto-Calc OFF)", minval=0.0)
manualLowMSTR = input.float(0.0, title="MSTR Swing Low (Override when Auto-Calc OFF)", minval=0.0)
dollarMSTR = input.float(0.0, title="MSTR $ Amount", minval=0.0)
swingHighMSTR = useAutoSwing ? autoHighMSTR : (manualHighMSTR > 0.0 ? manualHighMSTR : autoHighMSTR)
swingLowMSTR = useAutoSwing ? autoLowMSTR : (manualLowMSTR > 0.0 ? manualLowMSTR : autoLowMSTR)

// ========== STOCK 9: MU ==========
symMU = input.string("NASDAQ:MU", title="MU Symbol")
autoHighMU = request.security("NASDAQ:MU", "D", ta.highest(high, lookbackPeriod))
autoLowMU = request.security("NASDAQ:MU", "D", ta.lowest(low, lookbackPeriod))
