swingHighARM = useAutoSwing ? autoHighARM : (manualHighARM > 0.0 ? manualHighARM : autoHighARM)
swingLowARM = useAutoSwing ? autoLowARM : (manualLowARM > 0.0 ? manualLowARM : autoLowARM)

